# ===================================================================
# All-Included Deep Research - Backend Configuration
# ===================================================================
# This file contains all environment variables used by the backend
# Copy this file to .env and update the values as needed
# IMPORTANT: Replace all API keys with your actual keys!

# -------------------------------------------------------------------
# API Settings
# -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
DEBUG_MODE=false
LOG_LEVEL=INFO

# -------------------------------------------------------------------
# Database Settings
# -------------------------------------------------------------------
# SQLite (NEW - default)
SQLITE_DB_PATH=/app/data/research.db
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_PERSIST_DIR=/app/data/vector_store
USE_POSTGRES=false

# PostgreSQL (DEPRECATED - kept for migration)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=deep_research
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_POOL_SIZE=10

# -------------------------------------------------------------------
# Memory Settings
# -------------------------------------------------------------------
MEMORY_DIR=/root/asudakov/projects/all_included_deep_research/memory_files
CHUNK_SIZE=800
CHUNK_OVERLAP=200

# -------------------------------------------------------------------
# Embedding Provider
# Choose: openai, ollama, cohere, huggingface, mock
# -------------------------------------------------------------------
EMBEDDING_PROVIDER=huggingface
EMBEDDING_DIMENSION=1536

# OpenAI Embeddings
# OpenRouter Configuration (OpenAI-compatible API)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=your-openrouter-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama Embeddings (local, free)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Cohere Embeddings
COHERE_API_KEY=your-cohere-api-key-here
COHERE_EMBEDDING_MODEL=embed-english-v3.0
COHERE_INPUT_TYPE=search_document

# HuggingFace Embeddings
HUGGINGFACE_API_KEY=your-huggingface-api-key-here
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_USE_LOCAL=true

# -------------------------------------------------------------------
# Search Provider
# Choose: tavily, searxng, mock
# -------------------------------------------------------------------
SEARCH_PROVIDER=searxng

# Tavily Search
TAVILY_API_KEY=tvly-your-tavily-api-key-here
TAVILY_MAX_RESULTS=8

# SearXNG Search
SEARXNG_INSTANCE_URL=http://localhost:8080
SEARXNG_API_KEY=
SEARXNG_MAX_RESULTS=8
SEARXNG_LANGUAGE=auto
SEARXNG_CATEGORIES=
SEARXNG_ENGINES=startpage,brave
SEARXNG_SAFESEARCH=0
# SEARCH_BLOCKED_DOMAINS=reddit.com,quora.com,facebook.com,instagram.com,tiktok.com,youtube.com,youtu.be,steamcommunity.com,fandom.com,wikia.com,discord.gg
# SEARCH_BLOCKED_KEYWORDS=model kit,scale model,figure set,steam workshop

# -------------------------------------------------------------------
# LLM Models (LiteLLM format: provider:model_name)
# Examples: openai:gpt-4o, anthropic:claude-3-5-sonnet-20241022
# -------------------------------------------------------------------
LLM_MODE=live

# Using OpenRouter (OPENAI_BASE_URL=https://openrouter.ai/api/v1)

CHAT_MODEL=qwen/qwen3-next-80b-a3b-instruct
CHAT_MODEL_MAX_TOKENS=131072

SEARCH_SUMMARIZATION_MODEL=qwen/qwen3-next-80b-a3b-instruct
SEARCH_SUMMARIZATION_MODEL_MAX_TOKENS=131072

RESEARCH_MODEL=qwen/qwen3-next-80b-a3b-instruct
RESEARCH_MODEL_MAX_TOKENS=131072

COMPRESSION_MODEL=qwen/qwen3-next-80b-a3b-instruct
COMPRESSION_MODEL_MAX_TOKENS=131072

FINAL_REPORT_MODEL=qwen/qwen3-next-80b-a3b-instruct
FINAL_REPORT_MODEL_MAX_TOKENS=131072

# Anthropic (if using Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# -------------------------------------------------------------------
# Research Mode Configuration
# -------------------------------------------------------------------
# Speed Mode (fast answers)
SPEED_MAX_ITERATIONS=2
SPEED_MAX_CONCURRENT=1

# Balanced Mode (balanced quality/speed)
BALANCED_MAX_ITERATIONS=6
BALANCED_MAX_CONCURRENT=3

# Quality Mode (deep research)
QUALITY_MAX_ITERATIONS=10
QUALITY_MAX_CONCURRENT=5

# -------------------------------------------------------------------
# Advanced Settings
# -------------------------------------------------------------------
# Search tuning
MEMORY_CONTEXT_LIMIT=6
SOURCES_LIMIT=8
SEARCH_CONTENT_MAX_CHARS=6000
CHAT_HISTORY_LIMIT=2
SIMPLE_SEARCH_MAX_RESULTS=5
SIMPLE_SEARCH_SCRAPE_TOP_N=2
DEEP_SEARCH_MAX_RESULTS=10
DEEP_SEARCH_QUERIES=3
DEEP_SEARCH_SCRAPE_TOP_N=5
DEEP_SEARCH_RERANK_TOP_K=8
DEEP_SEARCH_ITERATIONS=6
DEEP_SEARCH_QUALITY_MAX_RESULTS=16
DEEP_SEARCH_QUALITY_QUERIES=3
DEEP_SEARCH_QUALITY_SCRAPE_TOP_N=8
DEEP_SEARCH_QUALITY_RERANK_TOP_K=12
DEEP_SEARCH_QUALITY_ITERATIONS=25

# Retry settings
MAX_RETRIES=3
MAX_STRUCTURED_OUTPUT_RETRIES=3

# RRF (Reciprocal Rank Fusion) parameter
RRF_K=60

# Embedding batch size
EMBEDDING_BATCH_SIZE=100

# Allow clarification questions (quality mode)
ALLOW_CLARIFICATION=true

# Deep Research Multi-Agent Settings
DEEP_RESEARCH_NUM_AGENTS=4
DEEP_RESEARCH_ENABLE_CLARIFYING_QUESTIONS=true
DEEP_RESEARCH_RUN_DEEP_SEARCH_FIRST=true

# Deep Research Limits (centralized configuration)
DEEP_RESEARCH_MAX_SUPERVISOR_CALLS=12
DEEP_RESEARCH_AGENT_MAX_STEPS=10
DEEP_RESEARCH_SUPERVISOR_MAX_ITERATIONS=7
DEEP_RESEARCH_DEFAULT_MAX_ITERATIONS=20

# Web Scraper Settings
SCRAPER_TIMEOUT=30
SCRAPER_USE_PLAYWRIGHT=false
SCRAPER_SCROLL_ENABLED=false
SCRAPER_SCROLL_PAUSE=1.0
SCRAPER_MAX_SCROLLS=5

# OpenRouter Headers (optional)
OPENAI_API_HTTP_REFERER=
OPENAI_API_X_TITLE=
